WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=replace-with-your-WAHA_API_KEY
WAHA_SESSION=default

OBSIDIAN_VAULT_PATH=/absolute/path/to/your/vault
SYNC_SUBFOLDER=WhatsApp

# Snapshot window: how many days back to include by default.
LOOKBACK_DAYS=7

# If a chat has fewer than this many messages in the window, the script pulls
# older messages as context to reach this count. Set to 0 to disable padding.
MIN_MESSAGES_PER_CHAT=5

# Maximum messages pulled per chat (cap on window fetch size).
FETCH_LIMIT_PER_CHAT=200

# Upper bound on chats to consider (from WAHA /chats/overview).
CHATS_OVERVIEW_LIMIT=100

# Chat filtering. If CHAT_ALLOWLIST is non-empty it wins and denylist is ignored.
# Default denylist skips WhatsApp status updates.
CHAT_ALLOWLIST=
CHAT_DENYLIST=status@broadcast

LOG_LEVEL=info

# Optional voice-note transcription. When enabled, the sync downloads voice-note
# audio from WAHA and sends it to OpenAI for transcription.
TRANSCRIBE_AUDIO=0
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
